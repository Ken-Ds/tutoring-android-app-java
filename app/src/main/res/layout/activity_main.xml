<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/login_page_bg">

    <TextView
        android:id="@+id/viewTextCompanyName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="90dp"
        android:fontFamily="@font/roboto_light"
        android:text="Emicode"
        android:textColor="@color/white"
        android:textSize="50sp" />

    <EditText
        android:id="@+id/editTextCompanyEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/viewTextCompanyName"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="30dp"
        android:layout_marginTop="97dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/shape"
        android:padding="3dp"
        android:hint=" Company Email"
        android:textSize="25sp" />

    <EditText
        android:id="@+id/editTextCompanyPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/editTextCompanyEmail"
        android:layout_marginStart="30dp"
        android:layout_marginTop="54dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/shape"
        android:password="true"
        android:padding="3dp"
        android:hint=" Password"
        android:textSize="25sp" />


    <!--Di ko maayos ung button huhuh di ko alam bat ayaw niya magmatch tas purple pa background
    tas ung color nakaset naman sa white pero black pa din wala na niiyak nako-->
    <Button
        android:id="@+id/buttonLogIn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextCompanyPassword"
        android:layout_marginTop="28dp"
        android:background="@drawable/roundstyleborder"
        android:fontFamily="@font/roboto_light"
        android:hint="Log In"
        android:textColor="@color/white"
        android:textSize="25dp" />


</RelativeLayout>
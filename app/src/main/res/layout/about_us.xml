<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/textured_background">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emicode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="50dp"
                    android:textSize="80sp"
                    android:fontFamily="@font/computer_says_no"
                    android:text="EMICODE">

                </TextView>

                <TextView
                    android:id="@+id/emicode_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="20dp"
                    android:textSize="25sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipisicing elit. A, aliquam architecto eius error incidunt numquam quibusdam sunt ullam!"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/vision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="50dp"
                    android:textSize="40sp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/black"
                    android:text="Vision">

                </TextView>

                <TextView
                    android:id="@+id/vision_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="20dp"
                    android:textSize="25sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipisicing elit. A, aliquam architecto eius error incidunt numquam quibusdam sunt ullam!"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/mission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="50dp"
                    android:textSize="40sp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/black"
                    android:text="Mission">

                </TextView>

                <TextView
                    android:id="@+id/mission_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="20dp"
                    android:textSize="25sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipisicing elit. A, aliquam architecto eius error incidunt numquam quibusdam sunt ullam!"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/objectives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="50dp"
                    android:textSize="40sp"
                    android:fontFamily="@font/roboto_bold"
                    android:textColor="@color/black"
                    android:text="Objectives">

                </TextView>

                <TextView
                    android:id="@+id/objective_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="50dp"
                    android:textSize="25sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Lorem ipsum dolor sit amet, consectetur adipisicing elit. A, aliquam architecto eius error incidunt numquam quibusdam sunt ullam!"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Got any question?"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/contact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:textColor="@color/black"
                    android:text="Contact us at"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <TextView
                    android:id="@+id/emailAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="147dp"
                    android:layout_marginBottom="50dp"
                    android:layout_marginTop="-27dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_black"
                    android:text="admin@emicode.com"
                    android:textColor="@color/ourBlue"
                    android:gravity="start|end"
                    android:textAlignment="viewStart">

                </TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_alignParentBottom="true"
                    android:background="#a8b4d8">

                    <ImageButton
                        android:id="@+id/imageButtonBackLP1"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arrowleft" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>



    </ScrollView>


</RelativeLayout>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ourBlue">


    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="185dp"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/submission_check" />
            </LinearLayout>


            <TextView
                android:id="@+id/textViewLesson1"
                android:layout_width="wrap_content"
                android:layout_height="100dp"
                android:layout_marginStart="0dp"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/roboto_black"
                android:text="Your summative test has been successfully submitted!"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textView3"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="TextView" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/roboto_black"
                android:text="Score : "
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textView4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/roboto_black"
                android:text="Remarks : Failed"
                android:textAlignment="textStart"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="162dp"
                android:text="TextView" />

            <TextView
                android:id="@+id/textView6"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-10dp"
                android:fontFamily="@font/roboto_black"
                android:text="* Please contact your HR department for further discussion of your career with us. Thank you."
                android:textAlignment="textStart"
                android:textColor="#FFDE59"
                android:textSize="15sp"
                android:textStyle="italic" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dip"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackTP1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
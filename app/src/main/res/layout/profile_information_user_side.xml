<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/textured_background">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:orientation="vertical"
                android:layout_marginTop="75dp"
                android:layout_marginLeft="130dp">

                <ImageView
                    android:id="@+id/profile_pic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/custom_profile">

                </ImageView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="50dp">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Name: Emily Sotelo">

                </TextView>

                <TextView
                    android:id="@+id/email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Email: emilysotelo@emicode.com">

                </TextView>

                <TextView
                    android:id="@+id/employee_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Employee ID: 2230908">

                </TextView>

                <TextView
                    android:id="@+id/prof_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginLeft="20dp"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Profile Information">

                </TextView>

                <TextView
                    android:id="@+id/gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="Gender: Alien">

                </TextView>

                <TextView
                    android:id="@+id/date_of_birth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="November 25, 1993">

                </TextView>

                <TextView
                    android:id="@+id/date_hired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="December 25, 2023">

                </TextView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="30dp">

                <TextView
                    android:id="@+id/lesson1_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Lesson 1 Progress">

                </TextView>

                <ProgressBar
                    android:id="@+id/progressBar_lesson1"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="313dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="50dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progressTint="#1e5180"
                    >

                </ProgressBar>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="30dp">

                <TextView
                    android:id="@+id/lesson2_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Lesson 2 Progress">

                </TextView>

                <ProgressBar
                    android:id="@+id/progressBar_lesson2"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:indeterminate="false"
                    android:layout_width="313dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="50dp"
                    android:max="100"
                    android:progressTint="#1e5180">

                </ProgressBar>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="30dp">

                <TextView
                    android:id="@+id/lesson3_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Lesson 3 Progress">

                </TextView>

                <ProgressBar
                    android:id="@+id/progressBar_lesson3"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_marginBottom="40dp"
                    android:indeterminate="false"
                    android:layout_width="313dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="50dp"
                    android:max="100"
                    android:progressTint="#1e5180">

                </ProgressBar>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/viewRecords"
                    android:background="@drawable/rounded_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="120dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto_regular"
                    android:padding="8dp"
                    android:text="View Records"
                    android:textSize="25sp"
                    app:backgroundTint="#1e5180">

                </Button>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_alignParentBottom="true"
                    android:background="#a8b4d8">

                    <ImageButton
                        android:id="@+id/imageButtonBackLP1"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="20dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arrowleft" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>



    </ScrollView>


</RelativeLayout>
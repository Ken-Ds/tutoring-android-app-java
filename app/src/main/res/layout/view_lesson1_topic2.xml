<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:background="#e9e9e9"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <com.google.android.material.navigation.NavigationView
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:id="@+id/nav_view"
        app:headerLayout="@layout/header"
        app:menu="@menu/lessons_menu"
        android:focusable="true"
        android:clickable="true"
        android:layout_gravity="start"/>

    <ScrollView
        android:id="@+id/LessonView2ScrollView"
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:background="#1e5180">
            </androidx.appcompat.widget.Toolbar>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/textViewLesson1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="LESSON 1"
                    android:textColor="@color/white"
                    android:textSize="50sp" />
            </LinearLayout>


            <TextView
                android:id="@+id/textViewTopic2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="TOPIC 2 : Spina de Rosula"
                android:fontFamily="@font/roboto_light"
                android:textSize="35sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/textView8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-----------------------------------------------------------------------------------------------------------"
                />

            <TextView
                android:id="@+id/textViewParagraph2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/textViewLesson1"
                android:layout_marginStart="20dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/roboto_light"
                android:justificationMode="inter_word"
                android:text=" Ut bibendum blandit tincidunt. In maximus, turpis placerat vestibulum lobortis, purus sapien venenatis risus. Curabitur vulputate suscipit arcu eget bibendum. Lorem ipsum dolor sit amet, consectetur adipiscing elit. , eu vehicula felis sapien a ligula. Nulla in aliquet urna, ac laoreet tellus. Maecenas eu commodo magna. In hac habitasse platea dictumst. Praesent porttitor est gravida, viverra augue et, tristique odio. Sed lacinia mi ut nisi tempus, ac blandit nunc blandit. Sed blandit ultrices efficitur. Integer eleifend cursus sapien, non lobortis nisi vestibulum ac. Aenean et sem porta turpis dapibus tempor in in nibh. Suspendisse laoreet purus nec est semper, id mattis mauris volutpat."
                android:textSize="40sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackVL1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />

                <ImageButton
                    android:id="@+id/imageButtonNextVL1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowright" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>

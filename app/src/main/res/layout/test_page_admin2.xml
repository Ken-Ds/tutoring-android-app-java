<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ourBlue">


    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <Button
                    android:id="@+id/addTest"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="25dp"
                    android:backgroundTint="@color/ourBlue"
                    android:text="+ Add Test"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <Button
                    android:id="@+id/editTest1"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="20dp"
                    android:backgroundTint="#879AD1"
                    android:fontFamily="@font/roboto_bold"
                    android:text="LESSON 1"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <ImageButton
                    android:id="@+id/deleteTest1"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_weight="1"
                    android:background="@color/ourBlue"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/delete_trashcan" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <Button
                    android:id="@+id/editTest2"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="20dp"
                    android:backgroundTint="#879AD1"
                    android:text="LESSON 2"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginBottom="20dp" />

                <ImageButton
                    android:id="@+id/deleteTest2"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:background="@color/ourBlue"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/delete_trashcan" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <Button
                    android:id="@+id/editTest3"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="20dp"
                    android:backgroundTint="#879AD1"
                    android:text="LESSON 3"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginBottom="20dp" />

                <ImageButton
                    android:id="@+id/deleteTest3"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:background="@color/ourBlue"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/delete_trashcan" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <Button
                    android:id="@+id/editSummative"
                    android:layout_width="250dp"
                    android:layout_height="65dp"
                    android:layout_marginStart="20dp"
                    android:backgroundTint="#879AD1"
                    android:text="SUMMATIVE"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:fontFamily="@font/roboto_bold"
                    android:layout_marginBottom="20dp" />

                <ImageButton
                    android:id="@+id/deleteSummativeTest"
                    android:layout_width="60dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="20dp"
                    android:layout_weight="1"
                    android:background="@color/ourBlue"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/delete_trashcan" />

            </LinearLayout>

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="181dp"
                android:text="TextView"
                android:textColor="@color/ourBlue"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dip"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackTP1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
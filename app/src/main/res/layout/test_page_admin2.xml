<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ourBlue">


    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="TEST"
                    android:textColor="@color/white"
                    android:textSize="65sp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <ImageButton
                    android:id="@+id/addTopicLesson1"
                    android:layout_width="86dp"
                    android:layout_height="73dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/ourBlue"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/add_sign" />

                <TextView
                    android:id="@+id/textViewLesson1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="LESSON 1"
                    android:textColor="@color/white"
                    android:textSize="50sp" />
            </LinearLayout>

            <Button
                android:id="@+id/L1T1"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L1T2"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                app:backgroundTint="#E9E9E9"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border" />

            <Button
                android:id="@+id/L1T3"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson1"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:text="Take Test"
                android:layout_marginStart="90dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:backgroundTint="#a8b4d8"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <ImageButton
                    android:id="@+id/addTopicLesson2"
                    android:layout_width="86dp"
                    android:layout_height="73dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/ourBlue"
                    app:srcCompat="@drawable/add_sign"
                    android:scaleType="fitCenter"
                    />

                <TextView
                    android:id="@+id/textViewLesson2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="LESSON 2"
                    android:textColor="@color/white"
                    android:textSize="50sp" />
            </LinearLayout>

            <Button
                android:id="@+id/L2T1"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L2T2"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L2T3"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson2"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="90dp"
                android:layout_marginTop="4dp"
                android:backgroundTint="#a8b4d8"
                android:text="Take Test"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <ImageButton
                    android:id="@+id/addTopicLesson3"
                    android:layout_width="86dp"
                    android:layout_height="73dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/ourBlue"
                    app:srcCompat="@drawable/add_sign"
                    android:scaleType="fitCenter"
                    />

                <TextView
                    android:id="@+id/textViewLesson3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="Lesson 3"
                    android:textColor="@color/white"
                    android:textSize="50sp" />

            </LinearLayout>

            <Button
                android:id="@+id/L3T1"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L3T2"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L3T3"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:background="@drawable/square_button_colored_border"
                app:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson3"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="90dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#a8b4d8"
                android:text="Take Test"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <Button
                android:id="@+id/summativeButton"
                android:layout_width="320dp"
                android:layout_height="65dp"
                android:layout_marginStart="35dp"
                android:backgroundTint="#879AD1"
                android:text="SUMMATIVE"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="30sp"
                android:fontFamily="@font/roboto_bold"
                android:layout_marginBottom="20dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dip"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackTP1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
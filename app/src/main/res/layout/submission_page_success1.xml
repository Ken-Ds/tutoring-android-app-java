<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ourBlue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_alignParentTop="true"
            android:background="#1e5180">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="wrap_content"
                android:layout_height="230dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitCenter"
                android:src="@drawable/checkmark_icon" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewLesson1"
            android:layout_width="313dp"
            android:layout_height="100dp"
            android:layout_marginStart="55dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/roboto_regular"
            android:text="Your summative test has been successfully submitted!"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="27sp" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="90dp"
            android:layout_marginBottom="45dp"
            android:fontFamily="@font/roboto_black"
            android:text="@string/remarks_passed"
            android:textAlignment="textStart"
            android:textColor="@color/white"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView4"
            android:layout_marginStart="20dp"
            android:layout_marginTop="60dp"
            android:layout_marginEnd="20dp"
            android:layout_above="@id/imageButtonBackTP1"
            android:fontFamily="@font/roboto_black"
            android:text="* Please contact your HR department for further discussion of your career with us. Thank you."
            android:textAlignment="textStart"
            android:textColor="#FFDE59"
            android:textSize="15sp"
            android:textStyle="italic" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:background="#a8b4d8">

        <ImageButton
            android:id="@+id/imageButtonBackTP1"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:scaleType="fitCenter"
            android:src="@drawable/arrowleft"
            android:contentDescription="Back to Dashboard"/>

        <Button
            android:id="@+id/buttonRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="180dp"
            android:layout_marginTop="29dp"
            android:background="@drawable/rounded_button"
            android:fontFamily="@font/roboto_light"
            android:scaleType="fitCenter"
            android:text="Records"
            android:textColor="@color/white"
            app:backgroundTint="#1e5180" />
    </LinearLayout>
</RelativeLayout>

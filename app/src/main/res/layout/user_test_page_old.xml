<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".UserTestPage">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:layout_alignParentTop="true"
                    android:background="#1e5180">

                    <TextView
                        android:id="@+id/textViewSummativeTest"
                        android:layout_width="288dp"
                        android:layout_height="114dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="SUMMATIVE\nTEST"
                        android:textColor="@color/white"
                        android:textSize="40sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:text="* Notice you only have 3 attempts to \ntake this test."
                    android:textColor="#FF1100"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textViewTopic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="24dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="Topic 1 - 3"
                    android:textColor="@color/black"
                    android:textSize="20sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/radio_group2"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textViewQ1"
                        android:layout_width="191dp"
                        android:layout_height="104dp"
                        android:layout_below="@+id/textViewLesson1"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_regular"
                        android:justificationMode="inter_word"
                        android:text="1. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                        android:textSize="18sp" />

                    <RadioGroup
                        android:id="@+id/radio_group1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioButtonA1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginTop="25dp"
                            android:text="A" />

                        <RadioButton
                            android:id="@+id/radioButtonB1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-8dp"
                            android:layout_marginTop="25dp"
                            android:text="B"/>

                        <RadioButton
                            android:id="@+id/radioButtonC1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-10dp"
                            android:layout_marginTop="25dp"
                            android:text="C"/>
                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/radio_group2"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textViewQ2"
                        android:layout_width="191dp"
                        android:layout_height="104dp"
                        android:layout_below="@+id/textViewLesson1"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_regular"
                        android:justificationMode="inter_word"
                        android:text="2. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                        android:textSize="18sp" />

                    <RadioGroup
                        android:id="@+id/radio_group2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <RadioButton
                            android:id="@+id/radioButtonA2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginTop="25dp"
                            android:text="A" />

                        <RadioButton
                            android:id="@+id/radioButtonB2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-8dp"
                            android:layout_marginTop="25dp"
                            android:text="B"/>

                        <RadioButton
                            android:id="@+id/radioButtonC2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-10dp"
                            android:layout_marginTop="25dp"
                            android:text="C"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/radio_group2"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textViewQ3"
                        android:layout_width="191dp"
                        android:layout_height="104dp"
                        android:layout_below="@+id/textViewLesson1"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_regular"
                        android:justificationMode="inter_word"
                        android:text="3.  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                        android:textSize="18sp" />

                    <RadioGroup
                        android:id="@+id/radio_group3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioButtonA3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginTop="25dp"
                            android:text="A" />

                        <RadioButton
                            android:id="@+id/radioButtonB3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-8dp"
                            android:layout_marginTop="25dp"
                            android:text="B"/>

                        <RadioButton
                            android:id="@+id/radioButtonC3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-10dp"
                            android:layout_marginTop="25dp"
                            android:text="C"/>
                    </RadioGroup>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/radio_group4"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textViewQ4"
                        android:layout_width="191dp"
                        android:layout_height="104dp"
                        android:layout_below="@+id/textViewLesson1"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/roboto_regular"
                        android:justificationMode="inter_word"
                        android:text="4. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                        android:textSize="18sp" />

                    <RadioGroup
                        android:id="@+id/radio_group4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioButtonA4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginTop="25dp"
                            android:text="A" />

                        <RadioButton
                            android:id="@+id/radioButtonB4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-8dp"
                            android:layout_marginTop="25dp"
                            android:text="B"/>

                        <RadioButton
                            android:id="@+id/radioButtonC4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-10dp"
                            android:layout_marginTop="25dp"
                            android:text="C"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@+id/radio_group5"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/textViewQ5"
                        android:layout_width="191dp"
                        android:layout_height="104dp"
                        android:layout_below="@+id/textViewLesson1"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/roboto_regular"
                        android:justificationMode="inter_word"
                        android:text="5. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                        android:textSize="18sp" />

                    <RadioGroup
                        android:id="@+id/radio_group5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radioButtonA5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="50dp"
                            android:layout_marginTop="25dp"
                            android:text="A" />

                        <RadioButton
                            android:id="@+id/radioButtonB5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-8dp"
                            android:layout_marginTop="25dp"
                            android:text="B"/>

                        <RadioButton
                            android:id="@+id/radioButtonC5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="-10dp"
                            android:layout_marginTop="25dp"
                            android:text="C"/>
                    </RadioGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="404dp"
                    android:layout_height="89dp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginTop="20dp"
                    android:background="#a8b4d8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textViewQ5"
                    app:layout_constraintVertical_bias="1.0">

                    <Button
                        android:id="@+id/buttonSubmitVT1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="290dp"
                        android:layout_marginTop="25dp"
                        android:background="@drawable/rounded_button"
                        android:fontFamily="@font/roboto_light"
                        android:scaleType="fitCenter"
                        android:text="Submit"
                        android:textColor="@color/white"
                        app:backgroundTint="#1e5180" />

                    <ImageButton
                        android:id="@+id/imageButtonBackVT1"
                        android:layout_width="76dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-360dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:scaleType="fitCenter"
                        android:src="@drawable/arrowleft"
                        android:contentDescription="Return Button"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
</androidx.core.widget.NestedScrollView>

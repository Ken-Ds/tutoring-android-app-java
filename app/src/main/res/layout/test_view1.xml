<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#e9e9e9">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/textViewLesson1Test"
                    android:layout_width="288dp"
                    android:layout_height="114dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/roboto_bold"
                    android:text="SUMMATIVE
                    TEST"
                    android:textColor="@color/white"
                    android:textSize="40sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular"
                android:text="* Notice you only have 3 attempts to take this test."
                android:textColor="#FF1100"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textViewTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_black"
                android:text="Topic 1 - 3"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textViewChoiceA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="300dp"
                android:layout_marginTop="-24dp"
                android:text="A"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textViewChoiceB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="340dp"
                android:layout_marginTop="-28dp"
                android:text="B"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textViewChoiceC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="380dp"
                android:layout_marginTop="-27dp"
                android:text="C"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/radio_group1"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/textViewQ1"
                    android:layout_width="180dp"
                    android:layout_height="92dp"
                    android:layout_below="@+id/textViewLesson1"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:justificationMode="inter_word"
                    android:text="1. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radio_group1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioButtonA1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="70dp"
                        />


                    <RadioButton
                        android:id="@+id/radioButtonB1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-8dp"
                        />

                    <RadioButton
                        android:id="@+id/radioButtonC1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-10dp"
                        />
                </RadioGroup>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/radio_group2"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/textViewQ2"
                    android:layout_width="185dp"
                    android:layout_height="92dp"
                    android:layout_below="@+id/textViewLesson1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:justificationMode="inter_word"
                    android:text="2. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radio_group2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioButtonA2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="70dp"
                        android:layout_marginTop="25dp" />


                    <RadioButton
                        android:id="@+id/radioButtonB2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-8dp"
                        android:layout_marginTop="25dp" />

                    <RadioButton
                        android:id="@+id/radioButtonC2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-14dp"
                        android:layout_marginTop="25dp" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/radio_group2"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/textViewQ3"
                    android:layout_width="188dp"
                    android:layout_height="92dp"
                    android:layout_below="@+id/textViewLesson1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:justificationMode="inter_word"
                    android:text="3.  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radio_group3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioButtonA3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="70dp"
                        android:layout_marginTop="25dp" />


                    <RadioButton
                        android:id="@+id/radioButtonB3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-8dp"
                        android:layout_marginTop="25dp" />

                    <RadioButton
                        android:id="@+id/radioButtonC3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-14dp"
                        android:layout_marginTop="25dp" />
                </RadioGroup>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/radio_group4"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/textViewQ4"
                    android:layout_width="183dp"
                    android:layout_height="92dp"
                    android:layout_below="@+id/textViewLesson1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:justificationMode="inter_word"
                    android:text="4. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radio_group4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioButtonA4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="70dp"
                        android:layout_marginTop="25dp" />


                    <RadioButton
                        android:id="@+id/radioButtonB4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-8dp"
                        android:layout_marginTop="25dp" />

                    <RadioButton
                        android:id="@+id/radioButtonC4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-14dp"
                        android:layout_marginTop="25dp" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_below="@+id/radio_group5"
                android:layout_marginTop="20dp">

                <TextView
                    android:id="@+id/textViewQ5"
                    android:layout_width="188dp"
                    android:layout_height="92dp"
                    android:layout_below="@+id/textViewLesson1"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/roboto_regular"
                    android:justificationMode="inter_word"
                    android:text="5. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut bibendum blandit tincidunt."
                    android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radio_group5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioButtonA5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="70dp"
                        android:layout_marginTop="25dp" />


                    <RadioButton
                        android:id="@+id/radioButtonB5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-8dp"
                        android:layout_marginTop="25dp" />

                    <RadioButton
                        android:id="@+id/radioButtonC5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-15dp"
                        android:layout_marginTop="25dp" />
                </RadioGroup>
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dip"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackVT1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />

                <Button
                    android:id="@+id/buttonSubmitVT1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="25dp"
                    android:background="@drawable/rounded_button"
                    android:fontFamily="@font/roboto_light"
                    android:scaleType="fitCenter"
                    android:text="Submit"
                    android:textColor="@color/white"
                    app:backgroundTint="#1e5180" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
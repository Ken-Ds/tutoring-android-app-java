<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/textured_background">


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/textViewAddUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADD USER"
                android:fontFamily="@font/roboto_bold"
                android:textSize="40sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewNameAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/editTextNameAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:background="@drawable/square_button_colored_border"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:paddingBottom="20dp"/>

            <TextView
                android:id="@+id/textViewEmployeeIDAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employee ID:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/editTextEmployeeIDAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:background="@drawable/square_button_colored_border"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:paddingBottom="20dp"/>

            <TextView
                android:id="@+id/textViewEmailAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/editTextEmailAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="text"
                android:background="@drawable/square_button_colored_border"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:paddingBottom="20dp"/>

            <TextView
                android:id="@+id/textViewPasswordAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"/>

            <EditText
                android:id="@+id/editTextPasswordAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:inputType="textPassword"
                android:background="@drawable/square_button_colored_border"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:paddingBottom="20dp" />

            <TextView
                android:id="@+id/textViewSexAU"
                android:layout_width="213dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_regular"
                android:text="Sex:"
                android:textSize="20sp" />

                <RadioGroup
                    android:id="@+id/radioButtonSex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="20dp">

                    <RadioButton
                        android:id="@+id/radioButtonA4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="-15dp"
                        android:text="F"
                        android:textSize="20sp"/>

                    <RadioButton
                        android:id="@+id/radioButtonB4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="90dp"
                        android:layout_marginTop="-46.5dp"
                        android:text="M"
                        android:textSize="20sp"/>
                </RadioGroup>
            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewDateHiredAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date Hired:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"/>

            <EditText
                android:id="@+id/editTextDateHiredAU"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:text="DD/MM/YYYY"
                android:inputType="number"
                android:fontFamily="@font/roboto_light"
                android:background="@drawable/square_button_colored_border"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="60dp"
                android:paddingTop="10dp"
                android:paddingLeft="8dp"
                android:paddingBottom="10dp"/>

        </LinearLayout>

            <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewProfilePictureAu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Profile Picture:"
                android:fontFamily="@font/roboto_regular"
                android:textSize="20sp"/>

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="350dp"
                    android:layout_height="125dp"
                    android:src="@drawable/custom_upload_picture_icon"
                    android:layout_marginLeft="20dp"/>

                <Button
                android:id="@+id/buttonUploadPictureAU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Picture"
                android:textColor="@color/black"
                android:layout_marginLeft="127dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dip"
            android:layout_alignParentBottom="true"
            android:background="#a8b4d8">

            <ImageButton
                android:id="@+id/imageButtonBackVT1"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:background="?android:attr/selectableItemBackground"
                android:scaleType="fitCenter"
                android:src="@drawable/arrowleft" />

            <Button
                android:id="@+id/buttonSubmitVT1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="210dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/rounded_button"
                android:fontFamily="@font/roboto_light"
                android:scaleType="fitCenter"
                android:text="Save"
                android:textColor="@color/white"
                app:backgroundTint="#1e5180" />
        </LinearLayout>
         </LinearLayout>
    </ScrollView>
</RelativeLayout>
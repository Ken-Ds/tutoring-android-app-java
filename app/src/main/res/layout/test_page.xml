<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/ourBlue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:layout_alignParentTop="true"
        android:background="#1e5180">

    </LinearLayout>

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/test"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="TEST"
                    android:textColor="@color/white"
                    android:textSize="65sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewLesson1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/roboto_black"
                android:text="Lesson 1"
                android:textColor="@color/white"
                android:textSize="50sp" />

            <Button
                android:id="@+id/L1T1"
                android:layout_width="291dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L1T2"
                android:layout_width="291dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:backgroundTint="#E9E9E9"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/L1T3"
                android:layout_width="293dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson1"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:text="Take Test"
                android:layout_marginStart="80dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:backgroundTint="#a8b4d8"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/textViewLesson2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="Lesson 2"
                    android:textColor="@color/white"
                    android:textSize="50sp" />
            </LinearLayout>

            <Button
                android:id="@+id/L2T1"
                android:layout_width="295dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L2T2"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L2T3"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson2"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:backgroundTint="#a8b4d8"
                android:text="Take Test"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

                <TextView
                    android:id="@+id/textViewLesson3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/roboto_black"
                    android:text="Lesson 3"
                    android:textColor="@color/white"
                    android:textSize="50sp" />

            </LinearLayout>

            <Button
                android:id="@+id/L3T1"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 1"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L3T2"
                android:layout_width="299dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 2"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/L3T3"
                android:layout_width="297dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Topic 3"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp"
                android:backgroundTint="#E9E9E9"/>

            <Button
                android:id="@+id/takeTestLesson3"
                android:layout_width="175dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="80dp"
                android:backgroundTint="#a8b4d8"
                android:text="Take Test"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:layout_alignParentTop="true"
                android:background="#1e5180">

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:background="#1e5180"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dip"
                android:layout_alignParentBottom="true"
                android:background="#a8b4d8">

                <ImageButton
                    android:id="@+id/imageButtonBackTP1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowleft" />

                <ImageButton
                    android:id="@+id/imageButtonNextTP1"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="210dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:scaleType="fitCenter"
                    android:src="@drawable/arrowright" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <corners android:radius="51dp" /> <!-- Adjust the corner radius here -->
            <solid android:color="#1e5180" />
        </shape>
    </item>

    <item android:left="51dp">
        <shape>
            <solid android:color="#1e5180" />
            <corners android:radius="51dp" /> <!-- Adjust the corner radius here -->
            <corners android:topRightRadius="51dp"
                android:topLeftRadius="51dp"
                android:bottomRightRadius="51dp"
                android:bottomLeftRadius="51dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <!-- border weight -->
            <corners android:radius="51dp" /> <!-- Adjust the corner radius here -->
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#1e5180" />
        </shape>
    </item>
</layer-list>
